<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Builder Studio</title>
    <meta name="description" content="AI Builder platform with automatic generation, build validation, preview, and deploy flow." />
    <style>
      :root {
        --bg: #07111f;
        --sidebar: rgba(15, 23, 42, 0.9);
        --panel: rgba(15, 23, 42, 0.7);
        --card: rgba(17, 24, 39, 0.8);
        --card-border: rgba(148, 163, 184, 0.18);
        --text: #e5eefb;
        --muted: #a5b4cf;
        --primary: #7c3aed;
        --secondary: #1ea5ff;
        --success: #34d399;
        --warning: #f59e0b;
        --danger: #ef4444;
        --shadow: 0 25px 60px rgba(15, 23, 42, 0.5);
      }

      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        min-height: 100%;
        font-family: Inter, "Segoe UI", sans-serif;
        background: radial-gradient(circle at top, #13233e 0%, #07111f 40%, #040b16 100%);
        color: var(--text);
      }
      body {
        min-height: 100vh;
      }
      button, textarea {
        font: inherit;
      }
      a { color: #cfe4ff; }
      .page-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 320px 1fr;
      }
      .sidebar {
        background: var(--sidebar);
        border-right: 1px solid var(--card-border);
        padding: 28px 20px;
      }
      .logo-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 26px;
      }
      .logo {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        font-weight: 800;
        box-shadow: var(--shadow);
      }
      .eyebrow {
        margin: 0 0 6px;
        color: var(--muted);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-size: 11px;
      }
      h1, h2, h3, p {
        margin: 0;
      }
      .ai-card,
      .panel,
      .prompt-panel,
      .workflow-panel,
      .result-panel {
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid var(--card-border);
        border-radius: 18px;
        box-shadow: var(--shadow);
      }
      .ai-card {
        padding: 18px 16px;
        margin-bottom: 18px;
      }
      .status-line {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
      }
      .dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--success);
      }
      .pulse {
        box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7);
        animation: pulse 1.7s infinite;
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.7); }
        70% { box-shadow: 0 0 0 12px rgba(52, 211, 153, 0); }
        100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
      }
      .small-text {
        margin-top: 8px;
        color: var(--muted);
        font-size: 13px;
      }
      .panel {
        padding: 18px 16px;
        margin-top: 18px;
      }
      .panel-title {
        font-weight: 700;
        margin-bottom: 12px;
      }
      .file-list {
        margin: 0;
        padding-left: 18px;
        color: var(--muted);
        line-height: 1.8;
      }
      .build-state {
        border-radius: 12px;
        background: rgba(124, 58, 237, 0.14);
        border: 1px solid rgba(124, 58, 237, 0.3);
        padding: 10px 12px;
        font-weight: 700;
        color: var(--text);
        letter-spacing: 0.08em;
      }
      .workspace {
        padding: 28px;
      }
      .workspace-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
      }
      .workspace-header h2 {
        font-size: clamp(2rem, 3vw, 3rem);
      }
      .workspace-actions {
        display: flex;
        gap: 12px;
      }
      .primary, .secondary, .generate-btn {
        border: none;
        border-radius: 14px;
        padding: 12px 18px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.18s ease, opacity 0.18s ease;
      }
      .primary, .generate-btn {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        box-shadow: 0 15px 28px rgba(124, 58, 237, 0.28);
      }
      .secondary {
        background: rgba(148, 163, 184, 0.12);
        color: var(--text);
        border: 1px solid var(--card-border);
      }
      .primary:hover, .secondary:hover, .generate-btn:hover {
        transform: translateY(-1px);
      }
      .prompt-panel {
        padding: 20px 22px;
      }
      .prompt-label {
        display: block;
        margin-bottom: 12px;
        color: var(--muted);
        font-weight: 600;
      }
      textarea {
        width: 100%;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        color: var(--text);
        padding: 16px;
        resize: vertical;
        min-height: 170px;
      }
      .controls-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 14px;
      }
      .helper-block {
        color: var(--muted);
        font-size: 13px;
      }
      .workflow-panel {
        margin-top: 24px;
        padding: 20px 22px;
      }
      .workflow-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .workflow-title {
        font-weight: 700;
      }
      .phase-pill, .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 11px;
        letter-spacing: 0.1em;
        font-weight: 800;
        text-transform: uppercase;
      }
      .phase-pill {
        background: rgba(34, 197, 94, 0.12);
        color: #9ae6b4;
        border: 1px solid rgba(34, 197, 94, 0.25);
      }
      .progress-steps {
        display: grid;
        grid-template-columns: repeat(8, minmax(0, 1fr));
        gap: 8px;
        margin-top: 20px;
      }
      .step {
        background: rgba(148, 163, 184, 0.08);
        border: 1px solid rgba(148, 163, 184, 0.14);
        color: var(--muted);
        border-radius: 10px;
        text-align: center;
        padding: 10px 8px;
        font-size: 9px;
        letter-spacing: 0.06em;
        font-weight: 700;
      }
      .step.active {
        background: rgba(124, 58, 237, 0.12);
        border-color: rgba(124, 58, 237, 0.35);
        color: #d7c7ff;
      }
      .progress-log {
        margin: 18px 0 0;
        padding-left: 20px;
        color: var(--muted);
        line-height: 1.9;
      }
      .result-panel {
        margin-top: 24px;
        padding: 22px;
      }
      .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }
      .result-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 16px;
      }
      .result-box {
        background: rgba(15, 23, 42, 0.62);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 18px;
      }
      .mini-label {
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 12px;
      }
      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .tag-list span {
        background: rgba(59, 130, 246, 0.12);
        border: 1px solid rgba(96, 165, 250, 0.2);
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 12px;
        color: #cfe4ff;
      }
      .result-link {
        color: #cfe4ff;
        text-decoration: none;
        word-break: break-all;
      }
      .status-badge.idle { background: rgba(148, 163, 184, 0.12); color: var(--muted); }
      .status-badge.ready { background: rgba(52, 211, 153, 0.12); color: #c8f9de; }
      .status-badge.error { background: rgba(239, 68, 68, 0.12); color: #fecaca; }
      @media (max-width: 1024px) {
        .page-shell { grid-template-columns: 1fr; }
        .sidebar {
          border-right: none;
          border-bottom: 1px solid var(--card-border);
        }
      }
      @media (max-width: 720px) {
        .workspace { padding: 18px; }
        .workspace-header,
        .controls-row,
        .workflow-head,
        .result-header { flex-direction: column; align-items: flex-start; }
        .progress-steps,
        .result-grid { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="page-shell">
      <aside class="sidebar">
        <div class="logo-wrap">
          <div class="logo">AI</div>
          <div>
            <p class="eyebrow">Builder Studio</p>
            <h1>Project AI</h1>
          </div>
        </div>

        <div class="ai-card">
          <div class="status-line">
            <span class="dot pulse"></span>
            <span>System ready</span>
          </div>
          <p class="small-text">AI project context active</p>
        </div>

        <div class="panel">
          <p class="panel-title">Project context</p>
          <ul class="file-list">
            <li>index.html</li>
            <li>styles.css</li>
            <li>app.js</li>
            <li>workspace/project</li>
          </ul>
        </div>

        <div class="panel">
          <p class="panel-title">Build status</p>
          <div id="buildState" class="build-state">IDLE</div>
        </div>
      </aside>

      <main class="workspace">
        <header class="workspace-header">
          <div>
            <p class="eyebrow">Prompt to product</p>
            <h2>AI Website Generator</h2>
          </div>
          <div class="workspace-actions">
            <button class="secondary" id="previewBtn" type="button">Preview</button>
            <button class="primary" id="publishBtn" type="button">Publish</button>
          </div>
        </header>

        <section class="prompt-panel">
          <label for="promptInput" class="prompt-label">Jelaskan website atau aplikasi yang ingin kamu buat...</label>
          <textarea id="promptInput" rows="8" placeholder="Jelaskan website atau aplikasi yang ingin kamu buat..."></textarea>
          <div class="controls-row">
            <div class="helper-block">Ctrl + Enter / Cmd + Enter untuk generate</div>
            <button id="generateBtn" class="generate-btn" type="button">Generate</button>
          </div>
        </section>

        <section class="workflow-panel">
          <div class="workflow-head">
            <span class="workflow-title">Workflow</span>
            <span class="phase-pill" id="phaseLabel">ANALYZING</span>
          </div>

          <div class="progress-steps">
            <div class="step active">ANALYZING</div>
            <div class="step">PLANNING</div>
            <div class="step">GENERATING</div>
            <div class="step">WRITING FILES</div>
            <div class="step">BUILDING</div>
            <div class="step">TESTING</div>
            <div class="step">FIXING ERRORS</div>
            <div class="step">READY</div>
          </div>

          <ul id="progressLog" class="progress-log">
            <li>AI sedang menunggu prompt...</li>
          </ul>
        </section>

        <section class="result-panel">
          <div class="result-header">
            <h3>Project output</h3>
            <span id="statusBadge" class="status-badge idle">IDLE</span>
          </div>

          <div class="result-grid">
            <div class="result-box">
              <p class="mini-label">Files</p>
              <div id="resultFiles" class="tag-list">
                <span>index.html</span>
                <span>style.css</span>
                <span>app.js</span>
              </div>
            </div>

            <div class="result-box">
              <p class="mini-label">Preview URL</p>
              <a id="previewLink" href="#" class="result-link">Not ready yet</a>
            </div>

            <div class="result-box">
              <p class="mini-label">Publish URL</p>
              <a id="publishLink" href="#" class="result-link">Not published</a>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      const promptInput = document.getElementById('promptInput');
      const generateBtn = document.getElementById('generateBtn');
      const previewBtn = document.getElementById('previewBtn');
      const publishBtn = document.getElementById('publishBtn');
      const phaseLabel = document.getElementById('phaseLabel');
      const buildState = document.getElementById('buildState');
      const statusBadge = document.getElementById('statusBadge');
      const progressLog = document.getElementById('progressLog');
      const resultFiles = document.getElementById('resultFiles');
      const previewLink = document.getElementById('previewLink');
      const publishLink = document.getElementById('publishLink');
      const steps = Array.from(document.querySelectorAll('.step'));

      function updateStepState(activePhase) {
        const phaseOrder = ['analyzing', 'planning', 'generating', 'writing_files', 'building', 'testing', 'fixing_errors', 'ready', 'error'];
        steps.forEach(step => step.classList.remove('active'));
        const index = phaseOrder.indexOf(activePhase);
        if (index >= 0 && steps[index]) steps[index].classList.add('active');
      }

      function addLog(message) {
        const item = document.createElement('li');
        item.textContent = message;
        progressLog.prepend(item);
      }

      function setBuildState(value, cls = '') {
        buildState.textContent = value;
        buildState.className = 'build-state';
        if (cls) buildState.classList.add(cls);
      }

      async function generateProject() {
        const prompt = (promptInput.value || '').trim();
        if (!prompt) {
          alert('Silakan masukkan deskripsi website atau aplikasi yang ingin dibuat.');
          return;
        }

        generateBtn.disabled = true;
        generateBtn.textContent = 'Generating...';
        phaseLabel.textContent = 'ANALYZING';
        statusBadge.textContent = 'ANALYZING';
        statusBadge.className = 'status-badge idle';
        buildState.textContent = 'ANALYZING';
        addLog('AI sedang menganalisis kebutuhan pengguna...');

        try {
          const response = await fetch('/api/ai/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt })
          });

          if (!response.body) {
            addLog('Tidak ada stream response dari server.');
            return;
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const chunks = buffer.split('\n\n');
            buffer = chunks.pop() || '';

            for (const chunk of chunks) {
              const lines = chunk.split('\n');
              const eventLine = lines.find(line => line.startsWith('event: '));
              const dataLine = lines.find(line => line.startsWith('data: '));
              if (!eventLine || !dataLine) continue;

              const eventName = eventLine.replace('event: ', '').trim();
              const data = JSON.parse(dataLine.replace('data: ', '').trim());

              if (eventName === 'status') {
                const phase = (data.phase || 'analyzing').toUpperCase();
                phaseLabel.textContent = phase;
                addLog(data.message || `Status: ${phase}`);
                updateStepState(data.phase || 'analyzing');

                if (data.phase === 'ready') {
                  statusBadge.textContent = 'READY';
                  statusBadge.className = 'status-badge ready';
                  setBuildState('READY', 'ready');
                }

                if (data.phase === 'error') {
                  statusBadge.textContent = 'ERROR';
                  statusBadge.className = 'status-badge error';
                  setBuildState('ERROR', 'error');
                }
              }

              if (eventName === 'done') {
                if (data.ok) {
                  const files = Array.isArray(data.files) ? data.files : ['index.html'];
                  resultFiles.innerHTML = '';
                  files.forEach(file => {
                    const tag = document.createElement('span');
                    tag.textContent = file;
                    resultFiles.appendChild(tag);
                  });

                  previewLink.href = data.previewUrl || '#';
                  previewLink.textContent = data.previewUrl || 'Preview not available';
                  publishLink.href = data.deploymentUrl || '#';
                  publishLink.textContent = data.deploymentUrl || 'Publish not available';

                  statusBadge.textContent = 'READY';
                  statusBadge.className = 'status-badge ready';
                  setBuildState('READY', 'ready');
                  addLog(data.message || 'Project siap dibuka.');
                } else {
                  statusBadge.textContent = 'ERROR';
                  statusBadge.className = 'status-badge error';
                  setBuildState('ERROR', 'error');
                  addLog(data.message || 'Build gagal dan perlu perbaikan.');
                }
              }
            }
          }
        } catch (error) {
          console.error(error);
          addLog('Gagal memulai proses generate.');
          statusBadge.textContent = 'ERROR';
          statusBadge.className = 'status-badge error';
        } finally {
          generateBtn.disabled = false;
          generateBtn.textContent = 'Generate';
        }
      }

      async function handlePublish() {
        const projectResult = await fetch('/api/project/active');
        const projectData = await projectResult.json();
        const projectId = projectData.project?.id;

        if (!projectId) {
          addLog('Tidak ada project aktif untuk dipublish.');
          return;
        }

        const response = await fetch('/api/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ projectId })
        });

        const data = await response.json();
        if (data.ok) {
          publishLink.href = data.deploymentUrl;
          publishLink.textContent = data.deploymentUrl;
          addLog('Deployment berhasil dipublish.');
        } else {
          addLog(data.message || 'Publish gagal.');
        }
      }

      async function handlePreview() {
        const projectResult = await fetch('/api/project/active');
        const projectData = await projectResult.json();
        const projectId = projectData.project?.id;

        if (!projectId) {
          addLog('Belum ada project aktif untuk preview.');
          return;
        }

        const url = `http://localhost:3000/project/${projectId}/preview/`;
        previewLink.href = url;
        previewLink.textContent = url;
        window.open(url, '_blank', 'noopener,noreferrer');
      }

      generateBtn.addEventListener('click', generateProject);
      previewBtn.addEventListener('click', handlePreview);
      publishBtn.addEventListener('click', handlePublish);

      promptInput.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
          generateProject();
        }
      });

      setBuildState('IDLE');
      updateStepState('analyzing');
    </script>
  </body>
</html>
